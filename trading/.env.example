# Copy to .env. Do not commit .env. Backtest and pytest do not need these.

# Alpaca paper keys (required only to run main.py)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# News signal (required only to run main.py)
GOOGLE_API_KEY=
TAVILY_API_KEY=

# confirm asks before every buy and sell. auto does not prompt.
# The size cap and the daily loss halt apply in both modes.
TRADE_MODE=confirm

# Optional. Defaults match the comments.
MAX_TRADE_NOTIONAL=1000
DAILY_LOSS_LIMIT=500
STOP_LOSS_PCT=0.05
TARGET_WEIGHT=0.20
REBALANCE_BAND=0.25
CYCLE_SECONDS=1800
CLOSED_WAIT_SECONDS=900
WATCHLIST=AAPL,MSFT,GOOG
TRADE_LOG_PATH=trades.csv
TRADE_STATE_PATH=trading_state.json
