# Wilson environment variables
# Copy this file to .env.local and fill in your keys.
# Never commit .env.local or paste real keys into chat.

# OpenRouter API key — get one at https://openrouter.ai/keys
VITE_OPENROUTER_KEY=sk-or-v1-your-key-here

# Alchemy Ethereum Mainnet API key — create one in your Alchemy dashboard
ALCHEMY_API_KEY=your-alchemy-api-key-here
