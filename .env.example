# Wilson environment variables
# Copy this file to .env.local and fill in your keys.
# Never commit .env.local or paste real keys into chat.

# OpenRouter API key — get one at https://openrouter.ai/keys
VITE_OPENROUTER_KEY=sk-or-v1-your-key-here

# Alchemy Ethereum Mainnet API key — create one in your Alchemy dashboard
ALCHEMY_API_KEY=your-alchemy-api-key-here

# ---- Operator mode (all optional) ----
# Address of your optional live-browser Worker (workers/operator-browser). Not a secret.
# You can also paste it in Operator → ⚙︎ instead.
# VITE_OPERATOR_BROWSER_URL=https://wilson-operator-browser.your-subdomain.workers.dev
# Do NOT put the Groq key or the Operator browser key here: anything starting with VITE_
# is baked into the public website. Paste those in Operator → ⚙︎ on your own device.
