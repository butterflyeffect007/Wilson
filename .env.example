# Wilson environment variables
# Copy this file to .env.local and fill in your keys.
# Never commit .env.local or paste real keys into chat.

# Chat model keys live ONLY on the Wilson worker (Cloudflare secrets), never in the app.
# Anything starting with VITE_ is baked into the public app bundle, so never put a key in one.

# Alchemy Ethereum Mainnet API key — create one in your Alchemy dashboard
ALCHEMY_API_KEY=your-alchemy-api-key-here
